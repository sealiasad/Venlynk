# Contact form delivery. Configure at least one option.

# Option A: email via Resend (https://resend.com). Verify your domain there first.
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@venlynk.com
# Must be on a domain verified in Resend, e.g. "Venlynk website <website@venlynk.com>"
CONTACT_FROM_EMAIL=

# Option B: POST each inquiry as JSON to a webhook (Zapier, Make, Slack workflow, Google Apps Script…)
CONTACT_WEBHOOK_URL=
