# Contact form delivery. Configure at least one option.

# Option S: email via SMTP, e.g. the hello@venlynk.com Hostinger mailbox. Used instead of Resend when set.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Option A: email via Resend (https://resend.com). Verify your domain there first.
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@venlynk.com
# Must be on a domain verified in Resend, e.g. "Venlynk website <website@venlynk.com>"
CONTACT_FROM_EMAIL=

# Option B: POST each inquiry as JSON to a webhook (Zapier, Make, Slack workflow, Google Apps Script…)
CONTACT_WEBHOOK_URL=

# Analytics. Leave empty to keep a tag off. Set in Hostinger > Environment variables, then redeploy.
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# Microsoft Clarity project ID (Settings > Overview), e.g. abcd1234ef
NEXT_PUBLIC_CLARITY_ID=
# LinkedIn Insight Tag partner ID, and optionally a conversion ID for form leads
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_LINKEDIN_LEAD_CONVERSION_ID=
# Meta Pixel ID (only if running Instagram or Facebook ads)
NEXT_PUBLIC_META_PIXEL_ID=
